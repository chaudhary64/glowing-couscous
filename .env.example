# Copy to `.env.local` and fill in. Committed on purpose — it carries key names, no
# values. Everything here comes from the Cognito pool and the RDS instance, and none
# of it is a secret except DATABASE_URL.

# ------------------------------------------------------------------- browser
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback/cognito

# -------------------------------------------------------------------- server
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=

# ----------------------------------------------------------------------- ai
# Google Gemini — the AI provider this build is wired to. The key is a real secret:
# it belongs in `.env.local` (gitignored) and never in this template.
#
# Bedrock was the intended path and is blocked in this AWS account — every call
# returns "Your account is currently being verified" — so the multimodal pipeline
# (photo + Hindi audio in one call) runs here instead. The model id is read at call
# time, so moving back to Bedrock is one file, not a rewrite.
# Primary model, then the one that answers when the primary is at capacity. Take
# ids from `models.list` rather than from memory. The substitute is never silent:
# every screen shows which model actually answered.
GEMINI_API_KEY=
# Use a key from the *free-tier* AI Studio project. A key from a Tier-1 prepay project
# that has run out of credits answers 402 for every model, including this one.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# --------------------------------------------------------------- database
# AWS RDS for PostgreSQL (ecoepr-db, ap-south-1). The password belongs in Secrets
# Manager or SSM, never in this file.
#
# sslmode=no-verify because node-postgres reads `require` as verify-full, which fails
# against the RDS certificate chain. RDS has rds.force_ssl=1, so plaintext is refused.
# DATABASE_URL=postgresql://ecoepr_admin:<password>@ecoepr-db.<id>.ap-south-1.rds.amazonaws.com:5432/ecoepr?sslmode=no-verify
DATABASE_URL=
