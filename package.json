{
  "name": "impactproof",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "s3:check": "node --import ./scripts/ts-paths.mjs --env-file=.env.local scripts/s3-check.mts",
    "pickup:setup": "bash scripts/pickup-setup.sh",
    "pickup:seed": "node --env-file=.env.local scripts/pickup-seed.mjs",
    "pickup:check": "node --env-file=.env.local scripts/pickup-check.mjs",
    "pickup:local": "node scripts/pickup-local.mjs",
    "pickup:test": "node scripts/pickup-local-test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb-streams": "^3.1149.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
