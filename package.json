{
  "name": "impactproof",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "s3:check": "node --import ./scripts/ts-paths.mjs --env-file=.env.local scripts/s3-check.mts",
    "rates:seed": "node --import ./scripts/ts-paths.mjs --env-file=.env.local scripts/rates-seed.mts",
    "predev": "node scripts/vendor-maplibre.mjs",
    "prebuild": "node scripts/vendor-maplibre.mjs",
    "test:heatmap": "node --import ./scripts/ts-paths.mjs --test lib/heatmap/heatmap.test.mts",
    "geo:wards": "node --import ./scripts/ts-paths.mjs scripts/geo-wards.mts",
    "geo:districts": "node --import ./scripts/ts-paths.mjs scripts/geo-districts.mts",
    "test:heatmap:db": "node --import ./scripts/ts-paths.mjs --test --test-concurrency=1 lib/heatmap/integration.test.mts",
    "pickup:setup": "bash scripts/pickup-setup.sh",
    "pickup:seed": "node --env-file=.env.local scripts/pickup-seed.mjs",
    "pickup:check": "node --env-file=.env.local scripts/pickup-check.mjs",
    "shots": "node --env-file=.env.local scripts/landing-shots.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report tests/e2e/.report"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.2",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "maplibre-gl": "6.11.2",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb-streams": "^3.1149.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
