# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# except the template: names only, no values, so a new checkout knows what to set
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build output from the serverless half: `scripts/pickup-setup.sh` packages the Lambda
# here and stages its scratch JSON beside it. Reproducible from the source in `aws/`.
/dist

# freebuff (local agent state)
.freebuff
freebuff

# local log captures from Amplify/Cognito debugging — dumps of CloudWatch and the
# Amplify build output. Useful while diagnosing, never part of the app.
amplog*.json
amplog*.err
buildlog.json
buildlog.err
dev.log

# MapLibre worker, copied from node_modules by scripts/vendor-maplibre.mjs
/public/vendor/

# scratch for regenerating ward boundaries
/.tmp-geo/
/.models-src/
